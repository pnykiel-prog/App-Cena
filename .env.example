# Database (Neon PostgreSQL) — same Neon project as CareMap, separate database "carequote"
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.aws.neon.tech/carequote?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.aws.neon.tech/carequote?sslmode=require&channel_binding=require"

# NextAuth.js v5
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Resend (transactional email)
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM="office@bonamcuram.com"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WIDGET_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="CareQuote"

# Cron (Vercel) — sekret chroniący endpoint /api/cron/*. Ustaw w zmiennych
# środowiskowych projektu; Vercel Cron dołącza go jako Authorization: Bearer.
CRON_SECRET="generate-with: openssl rand -base64 32"
